# Copy to `.env.local` and fill in. Never commit `.env.local`.
#
# Without these the site still runs: every page works, the shop lists the print
# catalogue as price-on-request, and enquiries go out by email and WhatsApp.
# What needs them is live pricing, the admin dashboard and online payment.

# --- Supabase (Project Settings -> API) ---------------------------------------
# The anon key is meant to be public; row level security in supabase/schema.sql
# is what protects the data. Never put the service_role key in this file — it
# bypasses every policy and Vite ships everything here to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Razorpay (Dashboard -> Account & Settings -> API Keys) -------------------
# Only the publishable key id belongs here. The secret goes to Supabase, never
# into the frontend:
#   supabase secrets set RAZORPAY_KEY_ID=rzp_... RAZORPAY_KEY_SECRET=...
VITE_RAZORPAY_KEY_ID=
